# Postgres connection — local defaults below match `make db:up` / docker compose (port 5433).
# macOS via scripts/setup-macos.sh uses brew postgres on 5432 — the script rewrites this file for you.
# Production: a Neon (or any) pooled Postgres URL.
DATABASE_URL="postgresql://fedy:fedy@localhost:5433/fedy?schema=public"

# Signs session JWTs. Generate a real one with: openssl rand -hex 32
SESSION_SECRET="replace-with-output-of-openssl-rand-hex-32"
